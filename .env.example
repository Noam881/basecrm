# Non-secret example. scripts/configure-local.py generates independent private local env files.
APP_NAME="Awove Base CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8091
CRM_INSTALLATION=alpha
# CRM_MANIFEST=/run/installation/manifest.json
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55438
DB_DATABASE=base_alpha
DB_USERNAME=base_alpha
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=base_alpha_session
SESSION_ENCRYPT=true
CACHE_STORE=database
CACHE_PREFIX=base_alpha_
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1028
MAIL_FROM_ADDRESS=hello@alpha.example.test
MAIL_FROM_NAME="Alpha CRM"
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
LOG_CHANNEL=stack
