# Values are supplied outside the immutable application image.
APP_ENV=production
APP_DEBUG=false
APP_KEY=SET_UNIQUE_SECRET
APP_URL=https://crm.example.test
CRM_INSTALLATION=client-id
CRM_MANIFEST=/run/installation/manifest.json
DB_CONNECTION=pgsql
DB_HOST=private-database
DB_PORT=5432
DB_DATABASE=client_database
DB_USERNAME=client_runtime
DB_PASSWORD=SET_UNIQUE_SECRET
SESSION_DRIVER=database
SESSION_COOKIE=client_unique_session
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
CACHE_PREFIX=client_unique_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
LOG_LEVEL=warning
